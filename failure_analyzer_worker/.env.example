# ── Elasticsearch ──────────────────────────────────────────────
[Credentials]=http://localhost:9201
ELASTICSEARCH_INDEX=failure_solutions
ELASTICSEARCH_API_KEY=
SIMILARITY_THRESHOLD=0.75
SIMILARITY_TOP_K=3


# ── Embedding model (sentence-transformers) ───────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2


# ── LLM (Groq) ───────────────────────────────────────────────
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048


# ── Worker HTTP server ───────────────────────────────────────
# Must match the listener's WORKER_INGEST_URL port and WORKER_INGEST_API_KEY
WORKER_HOST=127.0.0.1
WORKER_PORT=8090
WORKER_API_KEY=replace-me

