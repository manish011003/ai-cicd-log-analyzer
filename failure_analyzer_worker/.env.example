# ─── LLM provider ──────────────────────────────────────────────────────────
# Swap the backing LLM by changing LLM_PROVIDER and (optionally) LLM_API_BASE.
# Supported: groq | openai | anthropic | ollama
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# Generic API key used by every hosted provider. For LLM_PROVIDER=groq we also
# accept the legacy GROQ_API_KEY so older .env files keep working.
LLM_API_KEY=
GROQ_API_KEY=

# Optional: override base URL (OpenAI-compatible gateways, Azure, Ollama host, …)
# LLM_API_BASE=https://api.openai.com/v1
# LLM_API_BASE=http://ollama:11434

# Set to 0 only behind a corporate MITM proxy with a self-signed root CA.
LLM_TLS_VERIFY=1

# ─── Embeddings ───────────────────────────────────────────────────────────
# Supported: sentence_transformers | openai
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
# 0 = auto-detect from the model (sentence-transformers). Set explicitly when
# the embedder can't report its size (e.g. OpenAI shortened dimensions).
EMBEDDING_DIMENSIONS=0
# Reuse LLM_API_KEY if empty and EMBEDDING_PROVIDER=openai.
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=

# ─── Vector store ─────────────────────────────────────────────────────────
# Supported: elasticsearch
VECTOR_STORE_PROVIDER=elasticsearch
SIMILARITY_THRESHOLD=0.75
SIMILARITY_TOP_K=3
SIMILARITY_NUM_CANDIDATES=50

ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=failure_solutions
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_REQUEST_TIMEOUT_SECONDS=30
# Document TTL (delete_by_query on created_at): accepted solutions are the only
# things we persist in ES, since the fingerprint is the retrieval key.
ELASTICSEARCH_RETENTION_SOLUTIONS_DAYS=1095

# ─── Prompt overrides ────────────────────────────────────────────────────
# Point at a directory that contains system.md / with_context.md / fresh.md /
# clarify_system.md to override the packaged defaults.
PROMPTS_DIR=

# ─── Worker HTTP server ──────────────────────────────────────────────────
WORKER_HOST=127.0.0.1
WORKER_PORT=8090
WORKER_API_KEY=replace-me

# ─── Web UI hook ─────────────────────────────────────────────────────────
# Worker POSTs ingest results so the dashboard can list rows.
WEB_UI_API_URL=http://127.0.0.1:8095
WEB_UI_PUBLIC_URL=http://127.0.0.1:3080
WEB_UI_SESSION_TIMEOUT_SECONDS=20

# ─── Log filter ──────────────────────────────────────────────────────────
LOG_BODY_MAX_CHARS=8000
