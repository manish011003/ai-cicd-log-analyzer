# ─────────────────────────────────────────────────────────────────────────────
#  Top-level environment variables consumed by docker-compose.yml.
#
#  Setup:
#      cp .env.example .env
#      # edit values below
#      docker compose up -d --build
# ─────────────────────────────────────────────────────────────────────────────

# ─── Required: shared secret across worker + listener + web-backend ────────
WORKER_API_KEY=replace-me-change-in-production

# ─── LLM provider (groq | openai | anthropic | ollama) ─────────────────────
# The active provider's SDK must be installed in the worker image
# (``failure_analyzer_worker/requirements.txt`` — see comments there).
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile

# Generic API key used by every hosted provider.
# For LLM_PROVIDER=groq we also accept the legacy GROQ_API_KEY.
LLM_API_KEY=
GROQ_API_KEY=

# Optional — override base URL (OpenAI-compatible gateways, Azure, Ollama, …)
# LLM_API_BASE=https://api.openai.com/v1
# LLM_API_BASE=http://ollama:11434

# ─── CI provider (jenkins) ─────────────────────────────────────────────────
CI_PROVIDER=jenkins
JENKINS_BASE_URL=http://host.docker.internal:8080
JENKINS_USER=
JENKINS_API_TOKEN=
JENKINS_FAILED_RSS_PATH=/rssFailed

# ─── Listener tuning (optional) ─────────────────────────────────────────────
POLL_INTERVAL_SECONDS=20
STATE_RETENTION_DAYS=30
WORKER_SEND_BATCH=true
REQUEST_TIMEOUT_SECONDS=300

# ─── Embedding provider (sentence_transformers | openai) ───────────────────
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
# 0 = auto-detect from the model; set explicitly for OpenAI shortened dims.
EMBEDDING_DIMENSIONS=0
# Set to 0 only behind a corporate MITM proxy with a self-signed root CA.
# Required when the worker hangs on first boot at "Load pretrained
# SentenceTransformer" because the HuggingFace CDN download silently fails
# its TLS handshake.
EMBEDDING_TLS_VERIFY=1

# ─── Vector store provider (elasticsearch) ─────────────────────────────────
VECTOR_STORE_PROVIDER=elasticsearch
# ELASTICSEARCH_INDEX=failure_solutions
# ELASTICSEARCH_API_KEY=

# ─── Prompt overrides ──────────────────────────────────────────────────────
# Mount a folder into the worker container and set this to override prompts
# without rebuilding the image. Empty = use the packaged defaults.
PROMPTS_DIR=

# ─── Browser-facing URL printed in worker logs as the session deep-link ────
WEB_UI_PUBLIC_URL=http://localhost:3080

# ─── TLS policy for outbound LLM calls (set to 0 only behind corporate MITM) ─
LLM_TLS_VERIFY=1

# ─── Optional port overrides (uncomment if defaults conflict on your host) ──
# POSTGRES_PUBLISH_PORT=5432
# ELASTICSEARCH_PUBLISH_PORT=9200
# KIBANA_PUBLISH_PORT=5601
# WORKER_PUBLISH_PORT=8090
# LISTENER_PUBLISH_PORT=8088
# WEB_BACKEND_PUBLISH_PORT=8095
# WEB_FRONTEND_PUBLISH_PORT=3080

# ─── Web API CORS (comma-separated origins, default "*") ───────────────────
# CORS_ORIGINS=http://localhost:3080,http://localhost:3000

# ─── Postgres retention (web-backend janitor) ──────────────────────────────
# Background sweep deletes sessions past SESSION_RETENTION_DAYS and chat
# messages past MESSAGE_RETENTION_DAYS. Accepted solutions live in ES with
# their own TTL (ELASTICSEARCH_RETENTION_SOLUTIONS_DAYS), so removing the
# Postgres session does NOT lose institutional knowledge.
SESSION_RETENTION_DAYS=180
MESSAGE_RETENTION_DAYS=90
RETENTION_RUN_INTERVAL_HOURS=24

# ─── Raw / chat log caps (worker) ──────────────────────────────────────────
# Bound how much raw log we persist per session and how much of it we ship
# back to the LLM in chat turns (default vs "Include raw log excerpt" toggle).
# RAW_LOG_MAX_CHARS=200000
# CHAT_LOG_EXCERPT_MAX_CHARS=12000
# CHAT_LOG_EXCERPT_MAX_CHARS_FULL=60000

# ─── Structural filter (worker) ────────────────────────────────────────────
# The filter selects anchor regions under a token budget (Pass 4 round-robin)
# and falls back to LOG_BODY_MAX_CHARS only as a hard ceiling. Lowering
# LOG_BODY_MAX_TOKENS saves LLM cost; raise it if your analyses miss context.
# LOG_BODY_MAX_TOKENS=1500
# LOG_BODY_MAX_CHARS=8000

# Detector plug-and-play: "auto" loads every bundled detector and each
# detector decides per-log whether to activate. Set "none" to disable all,
# or a CSV to pin a specific allowlist. Bundled today:
#   java_stack, python_traceback, node_stack, go_panic, generic_shell
# Example for a pure-Node shop:
#   FILTER_DETECTORS=node_stack,generic_shell
# FILTER_DETECTORS=auto
# FILTER_MAX_ACTIVE_DETECTORS=5


















