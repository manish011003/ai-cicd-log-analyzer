JENKINS_API_TOKEN=11d08dc85ebd7c6b0dd4a8af7bf2c2b171
JENKINS_FAILED_RSS_PATH=/rssFailed

# Polling cadence and lookback
POLL_INTERVAL_SECONDS=20
INITIAL_LOOKBACK_MINUTES=60
STEADY_LOOKBACK_MINUTES=5

# Postgres for idempotency and ingestion state
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jenkins_listener
STATE_RETENTION_DAYS=30

# Your downstream Stage-2 endpoint that will filter/process logs
WORKER_INGEST_URL=http://localhost:8090/ingest/failure
WORKER_INGEST_API_KEY=replace-me

# Optional limits
MAX_STAGE_LOG_CHARS=30000
REQUEST_TIMEOUT_SECONDS=30
