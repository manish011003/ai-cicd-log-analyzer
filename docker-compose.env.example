# DEPRECATED filename — kept for backward compatibility.
# Prefer the canonical Docker Compose convention:
#   cp .env.example .env
#
# This file mirrors .env.example and will be removed in a future release.
#
# Copy to ".env" in this directory for docker compose variable substitution:
#   cp docker-compose.env.example .env

# --- Required for worker LLM ---
GROQ_API_KEY=

# --- Shared secret: worker + listener + web-backend ---
WORKER_API_KEY=replace-me-change-in-production

# --- Jenkins (required for listener / listener-poller) ---
JENKINS_BASE_URL=http://host.docker.internal:8080
JENKINS_USER=
JENKINS_API_TOKEN=

# Optional Jenkins / listener tuning
JENKINS_FAILED_RSS_PATH=/rssFailed
POLL_INTERVAL_SECONDS=20
STATE_RETENTION_DAYS=30
WORKER_SEND_BATCH=true
REQUEST_TIMEOUT_SECONDS=300

# Link shown in worker logs for session URLs (browser hits your host)
WEB_UI_PUBLIC_URL=http://localhost:3080

# docker-compose.yml pins web-backend → listener:8088 and worker:8090 (do not use 8080; that is Jenkins).
# Listener talks to Jenkins via JENKINS_BASE_URL (default host.docker.internal:8080). Start Jenkins on the host
# or point JENKINS_BASE_URL at a reachable server, or poll will return upstream connection errors.

# Optional: publish ports if defaults conflict on your machine
# POSTGRES_PUBLISH_PORT=5432
# ELASTICSEARCH_PUBLISH_PORT=9200
# KIBANA_PUBLISH_PORT=5601
# WORKER_PUBLISH_PORT=8090
# LISTENER_PUBLISH_PORT=8088
# WEB_BACKEND_PUBLISH_PORT=8095
# WEB_FRONTEND_PUBLISH_PORT=3080

# Elasticsearch (worker)
# ELASTICSEARCH_INDEX=failure_solutions
# ELASTICSEARCH_API_KEY=

# LLM
# LLM_MODEL=llama-3.3-70b-versatile
# EMBEDDING_MODEL=all-MiniLM-L6-v2

# Web API CORS (passed to app if extended later)
# CORS_ORIGINS=*
