JENKINS_BASE_URL=http://localhost:8080
JENKINS_USER=user
JENKINS_API_TOKEN= add your token here
JENKINS_FAILED_RSS_PATH=/rssFailed


# Polling cadence
POLL_INTERVAL_SECONDS=20


# Postgres for idempotency and ingestion state
DATABASE_URL=[Credentials]
STATE_RETENTION_DAYS=30


# Your downstream Stage-2 endpoint that will filter/process logs
WORKER_INGEST_URL=http://localhost:8090/ingest/failure
WORKER_INGEST_API_KEY=replace-me


# Optional limits
MAX_STAGE_LOG_CHARS=30000
MAX_STAGE_SCAN_LINES=1200
PER_ERROR_CONTEXT_BEFORE=2
PER_ERROR_CONTEXT_AFTER=4
ERROR_ANCHOR_MERGE_GAP_LINES=3
PARALLEL_STAGE_OVERLAP_MS=2000
REQUEST_TIMEOUT_SECONDS=30

