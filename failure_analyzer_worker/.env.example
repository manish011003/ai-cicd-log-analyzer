# ── Elasticsearch ──────────────────────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=failure_solutions
ELASTICSEARCH_CONTEXT_INDEX=failure_context
ELASTICSEARCH_API_KEY=
# Document TTL (delete_by_query on created_at): solutions ~36mo, filtered-context ~18mo
ELASTICSEARCH_RETENTION_SOLUTIONS_DAYS=1095
ELASTICSEARCH_RETENTION_CONTEXT_DAYS=548
SIMILARITY_THRESHOLD=0.75
SIMILARITY_TOP_K=3

# ── Embedding model (sentence-transformers) ───────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── LLM (OpenAI-compatible) ──────────────────────────────────
GOOGLE_API_KEY=
LLM_MODEL=gemini-2.0-flash
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# ── Worker HTTP server ───────────────────────────────────────
WORKER_HOST=127.0.0.1
WORKER_PORT=8090
WORKER_API_KEY=replace-me

# Web UI hook: POST ingest results so the dashboard lists rows (FastAPI web backend)
WEB_UI_API_URL=http://127.0.0.1:8095
# Docker Compose UI is published on 3080 by default (3000 often blocked on Windows). Dev: 3000 or dev-ui profile 5173.
WEB_UI_PUBLIC_URL=http://127.0.0.1:3080

# Log pipeline: normalize → partition → template-dedupe → anchors → noise (unset = modern)
# LOG_FILTER_LEGACY=1
LOG_MAX_FILTERED_CHARS=16000
LOG_ANCHOR_BEFORE_LINES=14
LOG_ANCHOR_AFTER_LINES=18
LOG_ANCHOR_CONTEXT_BEFORE=2
LOG_DEDUPE_MIN_CONSECUTIVE=4
LOG_PARTITION_BY_SERVICE=1
LOG_ANCHOR_CHRONOLOGICAL=1
LOG_ANCHOR_MAX_POINTS=12
LOG_FIRST_FAILURE_MIN_SCORE=4
LOG_SHRINK_LATER_BUCKETS=1
LOG_LATER_BUCKET_AFTER_LINES=8
LOG_LATER_BUCKET_BEFORE_LINES=8
LOG_LATER_BUCKET_MAX_CHARS=4200
LOG_DEDUPE_SAME_ROOT_BUCKET=1
LOG_COMPRESS_WHITESPACE=1
LOG_BODY_MAX_CHARS=5000
