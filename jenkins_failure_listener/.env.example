JENKINS_BASE_URL=http://jenkins.example.com
JENKINS_USER=service-user
JENKINS_API_TOKEN=replace-me
JENKINS_FAILED_RSS_PATH=/rssFailed

# Polling cadence
POLL_INTERVAL_SECONDS=20

# Postgres for idempotency and ingestion state
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/jenkins_listener
STATE_RETENTION_DAYS=30

# Your downstream Stage-2 endpoint that will filter/process logs
WORKER_INGEST_URL=http://localhost:8090/ingest/failure
WORKER_INGEST_API_KEY=replace-me
# One POST per poll with {"failures":[...]} (recommended). Set false for legacy one-event-per-POST workers.
WORKER_SEND_BATCH=true

# Optional limits
MAX_STAGE_LOG_CHARS=50000
MAX_STAGE_SCAN_LINES=1200
PER_ERROR_CONTEXT_BEFORE=2
PER_ERROR_CONTEXT_AFTER=4
ERROR_ANCHOR_MERGE_GAP_LINES=3
MAX_ERROR_REGIONS_PER_STAGE=15
MIN_ANCHOR_SCORE_FOR_SNIPPET=2
PARALLEL_STAGE_OVERLAP_MS=2000
REQUEST_TIMEOUT_SECONDS=30
